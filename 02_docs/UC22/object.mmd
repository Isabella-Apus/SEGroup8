classDiagram
  class C["VoucherController"] {
    <<controller>>
    +handleRequest()
  }
  class VS["VoucherService"] {
    <<service>>
    +executeUseCase()
  }
  class V["Voucher"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class UV["UserVoucher"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class OS["OrderServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class O["OrderInfo"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  C --> VS : claim
  VS --> V : 校验状态、时间、库存和范围
  VS --> UV : insert unique user-vouch
  OS --> VS : occupyForOrder
  OS --> O : 保存优惠额和应付额
