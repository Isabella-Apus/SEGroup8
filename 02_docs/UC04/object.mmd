%% DESIGN-CLASS04
classDiagram
  class C["AdminUserController"] {
    <<controller>>
    +handleRequest()
  }
  class S["AdminUserServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class U["User"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class M["UserMapper"] {
    <<repository>>
    +load()
    +save()
  }
  class A["AdminAuditLogServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  C --> S : ban/unban
  S --> U : 校验目标存在且可管理
  S --> M : updateStatus
  S --> A : record
