sequenceDiagram
  actor User as 登录用户
  actor Admin as 管理员
  participant RAPI as ReportBlockController
  participant AAPI as AdminReportController
  participant CAPI as CreditController
  participant Guard as AccessControl
  participant RSvc as ReportBlockServiceImpl
  participant Credit as CreditServiceImpl
  participant Audit as AdminAuditLogService
  participant Reports as UserReportMapper
  participant Blocks as UserBlockMapper
  participant Users as UserMapper
  participant CreditLog as CreditScoreLogMapper
  participant DB as user/user_report/user_block/credit_score_log/admin_audit_log

  User->>RAPI: POST /api/report-block/report
  RAPI->>RSvc: submitReport(request)
  RSvc->>Users: 校验目标存在
  RSvc->>Reports: countActiveReport(reporter,target)
  RSvc->>Reports: insert(status=0)
  Reports->>DB: INSERT user_report
  RAPI-->>User: success

  User->>RAPI: POST /api/report-block/block
  RAPI->>RSvc: blockUser(request)
  RSvc->>Users: 校验目标存在和非本人
  RSvc->>Blocks: isBlocked / insert
  Blocks->>DB: INSERT user_block
  RAPI-->>User: success

  Admin->>AAPI: POST /api/admin/reports/audit
  AAPI->>Guard: requireAdmin(userMapper)
  AAPI->>RSvc: adminAuditReport(request)
  RSvc->>Reports: 查询并更新举报状态
  Reports->>DB: UPDATE user_report
  alt decision=1 成立
    RSvc->>Credit: onReportUpheld(...)
    Credit->>Users: 更新目标信用分
    Users->>DB: UPDATE user
    Credit->>CreditLog: insert信用日志
    CreditLog->>DB: INSERT credit_score_log
  end
  AAPI->>Audit: record(REPORT_UPHELD/REJECTED)
  Audit->>DB: INSERT admin_audit_log
  AAPI-->>Admin: success

  User->>CAPI: GET /api/credit/me
  CAPI->>Credit: getMyCredit()
  Credit->>Users: 查询用户和信用日志
  CAPI-->>User: CreditScoreVO
