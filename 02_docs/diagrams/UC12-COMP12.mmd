flowchart LR
  buyer["买家端<br/>OrderView / OrderDetailView"]
  controller["OrderController<br/>pay / cancel"]
  service["OrderService<br/>OrderServiceImpl"]
  state["OrderStateMachine<br/>动作与状态约束"]
  voucher["VoucherService<br/>核销 / 释放优惠券"]
  settlement["EscrowSettlementService<br/>商城币余额与流水"]
  notify["NotificationService<br/>RealtimePushService"]
  mapper["OrderInfoMapper / OrderItemMapper<br/>ProductMapper"]
  orderdb[("order_info / order_item")]
  productdb[("product")]
  voucherdb[("voucher / user_voucher")]
  financedb[("balance / transaction_record")]
  notifydb[("notification")]

  buyer -->|"POST /api/order/{id}/pay 或 cancel"| controller
  controller --> service
  service --> state
  service --> mapper
  service --> voucher
  service --> settlement
  service --> notify
  mapper --> orderdb
  mapper --> productdb
  voucher --> voucherdb
  settlement --> financedb
  notify --> notifydb
  service -->|"OrderVO"| controller
  controller --> buyer
