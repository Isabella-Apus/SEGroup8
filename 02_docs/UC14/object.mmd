classDiagram
  class C["OrderController/AdminOrderController"] {
    <<controller>>
    +handleRequest()
  }
  class S["OrderServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class Req["OrderRefundApplyRequest/AdminRefundDecisionRequest"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class O["OrderInfo"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class L["OrderAfterSaleLog"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class F["EscrowSettlementService"] {
    <<service>>
    +executeUseCase()
  }
  C --> S : apply/approve/reject
  S --> O : 校验售后期、状态、归属和 version
  S --> L : append action log
  S --> F : refundBuyerAndRecoverSel
