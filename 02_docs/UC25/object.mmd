%% DESIGN-CLASS25
classDiagram
  class C["NotificationController"] {
    <<controller>>
    +handleRequest()
  }
  class S["NotificationServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class N["Notification"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class M["NotificationMapper"] {
    <<repository>>
    +load()
    +save()
  }
  class P["RealtimePushService"] {
    <<service>>
    +executeUseCase()
  }
  class W["RealtimeWebSocketHandler"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  C --> S : list/read/readAll
  S --> M : query/update by userId
  S --> N : 创建业务通知并先持久化
  S --> P : pushToUser
  P --> W : sendMessage
