%% DESIGN-CLASS05
classDiagram
  class C["ReportBlockController/AdminReportController"] {
    <<controller>>
    +handleRequest()
  }
  class S["ReportBlockServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class R["UserReport"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class B["UserBlock"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class Credit["CreditServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class Log["CreditScoreLog"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  C --> S : report/block/review
  S --> R : 新建或流转举报状态
  S --> B : insert/delete 拉黑关系
  S --> Credit : adjustScore
  Credit --> Log : insert change record
