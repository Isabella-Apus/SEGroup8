%% DESIGN-CLASS01
classDiagram
  class C["AuthController"] {
    <<controller>>
    +handleRequest()
  }
  class S["AuthServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class Req["RegisterRequest/LoginRequest"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class U["User"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class M["UserMapper"] {
    <<repository>>
    +load()
    +save()
  }
  class P["PasswordUtils"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class J["JwtUtils"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  C --> S : register/login
  S --> M : selectByUsername
  S --> P : encode 或 matches
  S --> U : 构造用户与默认角色
  S --> J : generateToken
