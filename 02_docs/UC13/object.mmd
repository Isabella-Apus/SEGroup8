classDiagram
  class C["OrderController"] {
    <<controller>>
    +handleRequest()
  }
  class S["OrderServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class O["OrderInfo"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class L["LogisticsServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class T["LogisticsTrace"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class F["EscrowSettlementService"] {
    <<service>>
    +executeUseCase()
  }
  C --> S : shipSellerOrder/confirmR
  S --> O : 校验卖家/买家和状态版本
  S --> L : initializeOrAdvance
