sequenceDiagram
  actor Buyer as Buyer
  participant Cart as CartView
  participant API as OrderController
  participant Service as OrderServiceImpl
  participant Voucher as VoucherService
  participant DB as MySQL

  Buyer->>Cart: Select items and checkout
  Cart->>API: POST /api/order/create
  API->>Service: createOrder(request)
  Service->>DB: Read products, shop, address and block relation
  Service->>DB: Deduct inventory and insert order aggregate
  opt Voucher selected
    Service->>Voucher: occupyForOrder(...)
    Voucher->>DB: Validate and occupy user_voucher
  end
  alt All checks succeed
    Service-->>API: OrderVO
    API-->>Cart: Result<OrderVO>
    Cart->>API: GET /api/order/detail/{id}
    API-->>Cart: Persisted order detail
  else Any check fails
    Service->>DB: Roll back transaction
    API-->>Cart: Business error
  end

