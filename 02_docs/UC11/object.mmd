%% DESIGN-CLASS11
classDiagram
  class C["OrderController"] {
    <<controller>>
    +handleRequest()
  }
  class S["OrderServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class Req["CreateOrderRequest"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class P["Product/SecondhandProduct"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class O["OrderInfo"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class I["OrderItem"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class OM["OrderInfoMapper/OrderItemMapper"] {
    <<repository>>
    +load()
    +save()
  }
  C --> S : createMyOrders
  S --> Req : 合并商品项并校验地址
  S --> P : 读取价格、状态、库存和卖家
  S --> O : 构造 PENDING_PAY
  S --> I : 构造订单项快照
  S --> OM : insert order and items
