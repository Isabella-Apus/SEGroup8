%% DESIGN-CLASS12
classDiagram
  class Idem["IdempotencyInterceptor"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class C["OrderController"] {
    <<controller>>
    +handleRequest()
  }
  class S["OrderServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class O["OrderInfo"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class F["EscrowSettlementService"] {
    <<service>>
    +executeUseCase()
  }
  class B["Balance"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class T["TransactionRecord"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  Idem --> C : pay/cancel + X-Idempoten
  C --> S : payMyOrder/cancelMyOrder
  S --> O : 校验 owner/status/version
  S --> F : debitBuyer
  F --> B : optimistic update
  F --> T : insert payment record
