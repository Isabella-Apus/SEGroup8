%% DESIGN-CLASS19
classDiagram
  class C["SecondhandTradeController"] {
    <<controller>>
    +handleRequest()
  }
  class S["SecondhandTradeServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class P["SecondhandProduct"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class A["ProductAuction"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class L["AuctionLog"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  C --> S : placeBid
  S --> A : 检查 ONGOING 和最低出价
  S --> P : 检查 bidder != seller
  S --> L : 写出价记录
