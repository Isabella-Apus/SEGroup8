flowchart LR
  subgraph Browser[Microsoft Edge / Vue]
    Buyer[ChatView.vue /messages]
    Seller[ChatView.vue /merchant/messages]
    Api[chat.js]
    Client[realtimeClient.js]
  end

  subgraph Backend[Spring Boot]
    Auth[JWT 与 UserContext]
    Controller[ChatController]
    Service[ChatServiceImpl]
    ACL[参与者、来源和双向拉黑校验]
    ConversationMapper[ChatConversationMapper]
    MessageMapper[ChatMessageMapper]
    BlockMapper[UserBlockMapper]
    Notification[NotificationService]
    Push[RealtimePushService]
  end

  Conversation[(chat_conversation)]
  Message[(chat_message)]
  Block[(user_block)]
  Notice[(notification)]

  Buyer --> Api
  Seller --> Api
  Api -->|/api/chat/**| Auth --> Controller --> Service --> ACL
  ACL --> ConversationMapper --> Conversation
  ACL --> MessageMapper --> Message
  ACL --> BlockMapper --> Block
  Service --> Notification --> Notice
  Controller -->|持久化成功后尽力推送| Push --> Client
  Client --> Buyer
  Client --> Seller
