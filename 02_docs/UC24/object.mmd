%% DESIGN-CLASS24
classDiagram
  class C["ChatController"] {
    <<controller>>
    +handleRequest()
  }
  class S["ChatServiceImpl"] {
    <<service>>
    +executeUseCase()
  }
  class Req["ChatConversationCreateRequest/ChatMessageSendRequest"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class Conv["ChatConversation"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class Msg["ChatMessage"] {
    <<collaborator>>
    +applyBusinessRule()
  }
  class CM["ChatConversationMapper"] {
    <<repository>>
    +load()
    +save()
  }
  class MM["ChatMessageMapper"] {
    <<repository>>
    +load()
    +save()
  }
  C --> S : createConversation/sendM
  S --> Conv : 校验 user1/user2/source 和参
  S --> CM : selectUnique 或 insert
  S --> Msg : 校验非空内容和接收者
  S --> MM : insert
