@baseUrl = http://127.0.0.1:8089/api
@sellerToken = REPLACE_WITH_SELLER_TOKEN
@bidderToken = REPLACE_WITH_BIDDER_TOKEN
@productId = 1
@auctionId = 1

### 卖家发起拍卖
POST {{baseUrl}}/secondhand/trade/auction
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "productId": {{productId}},
  "startPrice": 50.00,
  "incrementAmount": 5.00,
  "durationMinutes": 60
}

### 买家查看商品拍卖
GET {{baseUrl}}/secondhand/trade/auction/product/{{productId}}
Authorization: Bearer {{bidderToken}}

### 买家出价
POST {{baseUrl}}/secondhand/trade/auction/{{auctionId}}/bid
Authorization: Bearer {{bidderToken}}
Content-Type: application/json

{
  "bidAmount": 60.00
}

### 卖家查看自己发起的拍卖
GET {{baseUrl}}/secondhand/trade/auction/seller/list?pageNum=1&pageSize=10
Authorization: Bearer {{sellerToken}}

### 卖家提前结束并触发结算
POST {{baseUrl}}/secondhand/trade/auction/{{auctionId}}/close
Authorization: Bearer {{sellerToken}}
